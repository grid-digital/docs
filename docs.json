  "footer": {
    "links": [
      {
        "header": "Cconnect",
        "items": [
          {
            "label": "Product",
            "href": "https://cconnect.online"
          },
          {
            "label": "OpenAPI specification",
            "href": "/openapi.json"
          }
        ]
      }
    ]
  },
  "description": "Integrate Cconnect Desk and Chat with company-scoped REST APIs.",
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "javascript",
        "python"
      ]
    }
  },
  "banner": {
    "content": "Customer API v1 preview. Availability requires the updated Omni API deployment and API enablement.",
    "type": "info"
  },
  "search": {
    "prompt": "Search Cconnect APIs and guides..."
  }
