  "favicon": "/favicon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "authentication"
            ]
          },
          {
            "group": "API conventions",
            "pages": [
              "pagination",
              "errors",
              "rate-limits",
              "idempotency"
            ]
          },
          {
            "group": "Integration guides",
            "pages": [
              "guides/ticket-sync",
              "guides/send-messages",
              "changelog"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Open Cconnect",
      "href": "https://cconnect.online"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "download-spec"
    ]
